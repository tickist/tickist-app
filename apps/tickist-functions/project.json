{
    "name": "tickist-functions",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/tickist-functions/src",
    "projectType": "application",
    "prefix": "tickist-functions",
    "generators": {},
    "targets": {
        "build": {
            "executor": "@simondotm/nx-firebase:build",
            "options": {
                "outputPath": "dist/apps/tickist-functions",
                "main": "apps/tickist-functions/src/main.ts",
                "tsConfig": "apps/tickist-functions/tsconfig.app.json",
                "packageJson": "apps/tickist-functions/package.json",
                "assets": ["apps/tickist-functions/src/assets"]
            },
            "outputs": ["{options.outputPath}"]
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx run tickist-functions:build && nx watch --projects=tickist-functions --includeDependentProjects -- nx build tickist-functions --clean=false",
                    "nx run tickist-functions:emulate"
                ]
            }
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": ["apps/tickist-functions/**/*.ts"]
            }
        },
        "deploy": {
            "executor": "nx:run-commands",
            "options": {
                "command": "firebase deploy --config firebase.json"
            }
        },
        "getconfig": {
            "executor": "nx:run-commands",
            "options": {
                "command": "firebase functions:config:get --config firebase.json > apps/tickist-functions/.runtimeconfig.json"
            }
        },
        "emulate": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "node -e 'setTimeout(()=>{},5000)'",
                    "kill-port --port 9099,5001,8080,9000,5000,8085,9199,9299,4000,4400,4500",
                    "firebase functions:config:get  --config firebase.json > dist/apps/tickist-functions/.runtimeconfig.json",
                    "firebase emulators:start  --config firebase.json"
                ],
                "parallel": false
            }
        },
        "test": {
            "executor": "@nrwl/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/tickist-functions/jest.config.ts",
                "passWithNoTests": true
            },
            "configurations": {
                "ci": {
                    "ci": true,
                    "codeCoverage": true
                }
            }
        }
    }
}
