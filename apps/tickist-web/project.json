{
  "name": "tickist-web",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/tickist-web/src",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.json",
        {
          "externalDependencies": ["typescript", "@angular/compiler-cli"]
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "ngc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "build": {
      "dependsOn": ["blog-content"],
      "outputs": ["{workspaceRoot}/dist/tickist-web"],
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      }
    },
    "blog-content": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run blog:check"
      }
    },
    "serve": {
      "options": {
        "host": "0.0.0.0",
        "port": 4200
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "tickist-web:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "args": ["src"]
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/tickist-web"],
      "options": {
        "maxWorkers": 1,
        "coverage.reportsDirectory": "../../coverage/tickist-web"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tickist-web:build",
        "port": 4200,
        "staticFilePath": "dist/tickist-web",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
